{
  "name": "opencode-triage",
  "version": "1.4.0",
  "description": "Skill discovery for OpenCode with automatic suggestions, keyword matching, and optional local multilingual embeddings",
  "license": "MIT",
  "author": "Carlos Spagnoletti",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "triage",
    "router",
    "skill-discovery",
    "token-optimization",
    "ai-coding-agent"
  ],
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "opencode-triage": "bin/opencode-triage.cjs"
  },
  "files": [
    "src/",
    "bin/",
    "postinstall.cjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "prepublishOnly": "npm run check && npm run test",
    "postinstall": "node postinstall.cjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": false
    }
  },
  "dependencies": {
    "jieba-wasm": "^2.4.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascharly/opencode-triage.git"
  },
  "bugs": {
    "url": "https://github.com/cascharly/opencode-triage/issues"
  },
  "homepage": "https://github.com/cascharly/opencode-triage#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
